# Images are published by .github/workflows/ci.yaml.
FRONTEND_IMAGE=ghcr.io/baypeline/creator-revenue-bridge-frontend
BACKEND_IMAGE=ghcr.io/baypeline/creator-revenue-bridge-backend

# Keep services private to the Windows host reverse proxy.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5386
BACKEND_PORT=8081

# Persistent PostgreSQL catalog used by the backend.
DATABASE_NAME=creator_revenue_bridge
DATABASE_USER=crb
DATABASE_PASSWORD=replace-with-a-long-random-password

# Public frontend origin accepted by the backend.
CRB_CORS_ALLOWED_ORIGINS=https://pricetext.store

# Use an authenticated Base Sepolia HTTPS or WSS endpoint.
WEB3_RPC_URL=https://your-base-sepolia-rpc.example
