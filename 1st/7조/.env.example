# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
ANVIL_PORT=8545

# PostgreSQL used by the backend. Change DATABASE_PASSWORD in production.
DATABASE_NAME=creator_revenue_bridge
DATABASE_USER=crb
DATABASE_PASSWORD=replace-with-a-long-random-password

# Local Anvil deployment. These are public deterministic development credentials.
ANVIL_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOCAL_ISSUER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
LOCAL_SETTLER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
LOCAL_CREATOR_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
LOCAL_INVESTOR_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
# Mock settlement token base units (6 decimals): 1,000,000 mUSD per actor
LOCAL_INVESTOR_BALANCE=1000000000000
LOCAL_SETTLER_BALANCE=1000000000000
LOCAL_TOKEN_BASE_URI=http://localhost:3000/api/revenue-rights/{id}.json

# The browser-accessible backend URL embedded in the frontend production build
NEXT_PUBLIC_API_URL=http://localhost:8080

# Required by compose.prod.yaml. Use an authenticated HTTPS/WSS RPC endpoint.
WEB3_RPC_URL=https://your-production-rpc.example

# Production images and host-only ports used by compose.prod.yaml
FRONTEND_IMAGE=ghcr.io/baypeline/creator-revenue-bridge-frontend
BACKEND_IMAGE=ghcr.io/baypeline/creator-revenue-bridge-backend
IMAGE_TAG=sha-replace-with-a-tested-commit
BIND_ADDRESS=127.0.0.1
CRB_CORS_ALLOWED_ORIGINS=https://pricetext.store

# Base Sepolia deployment. Copy these keys to an ignored local environment file.
BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc.example
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_ISSUER_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_SETTLER_ADDRESS=0x0000000000000000000000000000000000000000
# Leave unset to deploy the test-only MockSettlementToken with unrestricted minting.
BASE_SEPOLIA_SETTLEMENT_TOKEN_ADDRESS=
BASE_SEPOLIA_TOKEN_BASE_URI=https://your-app.example/api/revenue-rights/{id}.json
