# Copy to .env.prod and set the Collector address reachable from containers.
# 기본값은 compose 내부의 collector 서비스(http://collector:8000)입니다. 외부 Collector를 쓸 때만 변경합니다.
COLLECTOR_URL=http://collector:8000
# Collector LIVE 모드의 Solana JSON-RPC 주소 (Nodit 메인넷 엔드포인트)
SOLANA_RPC_URL=https://solana-mainnet.nodit.io
# Nodit API 키. 실제 키는 .env.prod에만 두고 저장소에 커밋하지 않습니다.
SOLANA_RPC_API_KEY=
SOLANA_RPC_PROVIDER=NODIT_SOLANA_RPC
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
VITE_CONSTELLATION_MODELS=0.2.0-research,0.2.0-single-leader
CORS_ALLOWED_ORIGINS=https://compliance.example.com
DEFAULT_RULESET_VERSION=1.0.0
