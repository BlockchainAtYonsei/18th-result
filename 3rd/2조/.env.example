# 복사하여 .env로 저장한 뒤 사용합니다. Docker Compose는 저장소 루트의 .env를 자동으로 읽습니다.
# 실제 API 키는 이 파일이나 저장소에 커밋하지 않습니다. SOLANA_RPC_URL이 비어 있으면 Collector는 LIVE 모드에서 503을 반환합니다.

# Collector LIVE 모드의 Solana JSON-RPC 주소 (Nodit 메인넷 엔드포인트)
SOLANA_RPC_URL=https://solana-mainnet.nodit.io
# Nodit API 키. 값은 요청 헤더(SOLANA_RPC_API_KEY_HEADER, 기본 X-API-KEY)로만 전송하며 로그·스냅샷에 기록하지 않습니다.
# 절대 커밋하지 마십시오.
SOLANA_RPC_API_KEY=
# 스냅샷 dataProvenance.source에 기록되는 제공자 이름
SOLANA_RPC_PROVIDER=NODIT_SOLANA_RPC
