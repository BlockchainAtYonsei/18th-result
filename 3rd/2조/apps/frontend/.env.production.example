# 배포 빌드 설정 예시. `.env.production`으로 복사하거나 CI의 빌드 환경 변수로 넣는다.
# 자세한 내용은 docs/backend-wiring.md.

# backend: 아래 주소의 Backend Public API를 직접 호출한다. mock: 브라우저 안의 Mock(MSW)만 쓴다.
VITE_API_MODE=backend

# Backend의 공개 HTTPS 주소(끝의 /는 빼도 된다). 이 출처는 Backend의 CORS_ALLOWED_ORIGINS에 프론트엔드 출처가 있어야 호출된다.
VITE_API_BASE_URL=https://backend.example.org

# Constellation Simulator에 등록된 모델 버전(쉼표 구분). simulations/constellation의 constellation.models.*.version과 같게 맞춘다.
VITE_CONSTELLATION_MODELS=0.1.0-draft,0.1.0-single-leader

# Backend의 수집기가 프론트 데모 시나리오(apps/frontend/demo)를 읽지 않으면 off. 운영 구성(compose.prod.yaml)은 off.
# off면 Backend 모드에서 데모 시나리오를 목록에서 빼고 기본값이 계약 fixture가 된다. Mock에서는 항상 보인다.
VITE_DEMO_FIXTURES=off

# 앱이 놓이는 경로. 도메인 루트면 /, GitHub Pages 프로젝트 페이지면 /<저장소 이름>/ (앞뒤 / 포함).
VITE_BASE_PATH=/
