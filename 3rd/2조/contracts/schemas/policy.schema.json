{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baypeline.github.io/solana-compliance-lab/contracts/schemas/policy.schema.json",
  "title": "policy",
  "$comment": "Unified team specifications; initial draft 0.1.0.",
  "$defs": {
    "TransactionIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "network": {
          "$ref": "common.schema.json#/$defs/Network"
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "recipient": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "asset": {
          "$ref": "common.schema.json#/$defs/Asset"
        },
        "amountRaw": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "requestedAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "intentId",
        "network",
        "sender",
        "recipient",
        "asset",
        "amountRaw",
        "requestedAt"
      ]
    },
    "PolicyDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intent": {
          "$ref": "policy.schema.json#/$defs/TransactionIntent"
        },
        "assessments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sender": {
              "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
            },
            "recipient": {
              "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
            }
          },
          "required": [
            "sender",
            "recipient"
          ]
        },
        "policyVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        }
      },
      "required": [
        "requestId",
        "intent",
        "assessments",
        "policyVersion"
      ]
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "NO_RISK_SIGNALS",
        "SANCTION_EXACT_MATCH",
        "SANCTION_DIRECT_FLOW_REVIEW",
        "SANCTION_DIRECT_FLOW_BLOCK",
        "INSUFFICIENT_ASSESSMENT",
        "RISK_SIGNALS_DETECTED",
        "HIGH_RISK_REVIEW",
        "HIGH_RISK_BLOCK",
        "HIGH_RISK_WARN"
      ]
    },
    "ComplianceDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "decisionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "action": {
          "$ref": "common.schema.json#/$defs/Action"
        },
        "riskScore": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "riskLevel": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/RiskLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "policy.schema.json#/$defs/ReasonCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "referencedEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "uniqueItems": true
        },
        "policyVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "evaluatedAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "schemaVersion",
        "decisionId",
        "intentId",
        "action",
        "riskScore",
        "riskLevel",
        "reasonCodes",
        "referencedEvidenceIds",
        "policyVersion",
        "evaluatedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "riskScore": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "riskLevel": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "riskLevel": {
                "$ref": "common.schema.json#/$defs/RiskLevel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskScore": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "riskLevel": {
                "const": "LOW"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskScore": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "riskLevel": {
                "type": "string",
                "enum": [
                  "MEDIUM",
                  "HIGH"
                ]
              }
            }
          }
        }
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "supportedRulesetVersions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Version"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "directFlowAction": {
          "type": "string",
          "enum": [
            "REVIEW",
            "BLOCK"
          ]
        },
        "warningAction": {
          "type": "string",
          "enum": [
            "WARN",
            "REVIEW"
          ]
        },
        "highRiskAction": {
          "type": "string",
          "enum": [
            "WARN",
            "REVIEW",
            "BLOCK"
          ]
        }
      },
      "required": [
        "version",
        "supportedRulesetVersions",
        "directFlowAction",
        "warningAction",
        "highRiskAction"
      ]
    }
  },
  "$ref": "#/$defs/ComplianceDecision"
}
